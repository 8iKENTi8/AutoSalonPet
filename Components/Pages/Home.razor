@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject CarCatalogService CarCatalog
@inject SalesFeedService SalesFeed

<PageTitle>Автосалон</PageTitle>

<h1>Автосалон</h1>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "cars" ? "active" : "")" @onclick="ShowCars">Машины</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "sales" ? "active" : "")" @onclick="ShowSales">Лента продаж</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "finance" ? "active" : "")" @onclick="ShowFinance">Финансы</button>
    </li>
</ul>

<div class="tab-content pt-3">
    @if (activeTab == "cars")
    {
        <p class="text-muted">Машины в наличии</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Марка</th>
                        <th>Модель</th>
                        <th>Год</th>
                        <th>Л.с.</th>
                        <th>Пробег</th>
                        <th>Состояние</th>
                        <th>Цвет</th>
                        <th>Цена</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in CarCatalog.Cars)
                    {
                        <tr>
                            <td>@car.Brand</td>
                            <td>@car.Model</td>
                            <td>@car.Year</td>
                            <td>@car.HorsePower</td>
                            <td>@Mileage(car)</td>
                            <td>@Condition(car)</td>
                            <td>@car.Color</td>
                            <td>@car.Price.ToString("N0") ₽</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "sales")
    {
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(salesTab == "new" ? "active" : "")" @onclick="ShowNewSales">Новые</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(salesTab == "used" ? "active" : "")" @onclick="ShowUsedSales">С пробегом</button>
            </li>
        </ul>

        <p class="text-muted">Новая продажа каждые 30 секунд</p>

        @if (VisibleSales.Count == 0)
        {
            <p>Пока продаж нет.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Время</th>
                            <th>Марка</th>
                            <th>Модель</th>
                            <th>Год</th>
                            <th>Л.с.</th>
                            <th>Пробег</th>
                            <th>Состояние</th>
                            <th>Цвет</th>
                            <th>Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in VisibleSales)
                        {
                            <tr>
                                <td>@sale.SoldAt.ToString("HH:mm:ss")</td>
                                <td>@sale.Car.Brand</td>
                                <td>@sale.Car.Model</td>
                                <td>@sale.Car.Year</td>
                                <td>@sale.Car.HorsePower</td>
                                <td>@Mileage(sale.Car)</td>
                                <td>@Condition(sale.Car)</td>
                                <td>@sale.Car.Color</td>
                                <td>@sale.Car.Price.ToString("N0") ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "finance")
    {
        <p class="text-muted">Бюджет компании</p>

        <table class="table">
            <tbody>
                <tr>
                    <td>Машин в наличии</td>
                    <td>@CarCatalog.Cars.Count</td>
                </tr>
                <tr>
                    <td>Стоимость машин в наличии</td>
                    <td>@CarCatalog.StockValue.ToString("N0") ₽</td>
                </tr>
                <tr>
                    <td>Баланс компании</td>
                    <td>@companyBalance.ToString("N0") ₽</td>
                </tr>
                <tr class="fw-bold">
                    <td>Общая сумма</td>
                    <td>@TotalAssets.ToString("N0") ₽</td>
                </tr>
            </tbody>
        </table>
    }
</div>

@code {
    private string activeTab = "cars";
    private string salesTab = "new";
    private decimal companyBalance = 20_000_000m;

    private IReadOnlyList<SaleRecord> VisibleSales => salesTab == "new" ? SalesFeed.GetNewSales() : SalesFeed.GetUsedSales();

    private decimal TotalAssets => companyBalance + CarCatalog.StockValue;

    protected override void OnInitialized()
    {
        SalesFeed.Changed += OnSalesFeedChanged;
    }

    private void OnSalesFeedChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string Mileage(Car car) => car.IsUsed ? $"{car.MileageKm:N0} км" : "0 км";

    private static string Condition(Car car) => car.IsUsed ? "С пробегом" : "Новая";

    private void ShowCars() => activeTab = "cars";

    private void ShowSales() => activeTab = "sales";

    private void ShowNewSales() => salesTab = "new";

    private void ShowUsedSales() => salesTab = "used";

    private void ShowFinance() => activeTab = "finance";

    public void Dispose() => SalesFeed.Changed -= OnSalesFeedChanged;
}
