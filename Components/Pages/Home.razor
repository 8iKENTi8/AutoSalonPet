@page "/"
@rendermode InteractiveServer

<PageTitle>Автосалон</PageTitle>

<h1>Автосалон</h1>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "cars" ? "active" : "")" @onclick="ShowCars">Машины</button>
    </li>
</ul>

<div class="tab-content pt-3">
    @if (activeTab == "cars")
    {
        <p class="text-muted">Машины в наличии</p>

        <table class="table">
            <thead>
                <tr>
                    <th>Марка</th>
                    <th>Модель</th>
                    <th>Год</th>
                    <th>Цена</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in cars)
                {
                    <tr>
                        <td>@car.Brand</td>
                        <td>@car.Model</td>
                        <td>@car.Year</td>
                        <td>@car.Price.ToString("N0") ₽</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

