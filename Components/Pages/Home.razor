@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject CarCatalogService CarCatalog

<PageTitle>Автосалон</PageTitle>

<h1>Автосалон</h1>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "cars" ? "active" : "")" @onclick="ShowCars">Машины</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "sales" ? "active" : "")" @onclick="ShowSales">Лента продаж</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(activeTab == "finance" ? "active" : "")" @onclick="ShowFinance">Финансы</button>
    </li>
</ul>

<div class="tab-content pt-3">
    @if (activeTab == "cars")
    {
        <p class="text-muted">Машины в наличии</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Марка</th>
                        <th>Модель</th>
                        <th>Год</th>
                        <th>Л.с.</th>
                        <th>Пробег</th>
                        <th>Состояние</th>
                        <th>Цвет</th>
                        <th>Цена</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in CarCatalog.Cars)
                    {
                        <tr>
                            <td>@car.Brand</td>
                            <td>@car.Model</td>
                            <td>@car.Year</td>
                            <td>@car.HorsePower</td>
                            <td>@Mileage(car)</td>
                            <td>@Condition(car)</td>
                            <td>@car.Color</td>
                            <td>@car.Price.ToString("N0") ₽</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "sales")
    {
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(salesTab == "new" ? "active" : "")" @onclick="ShowNewSales">Новые</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(salesTab == "used" ? "active" : "")" @onclick="ShowUsedSales">С пробегом</button>
            </li>
        </ul>

        <p class="text-muted">Новая продажа каждые 30 секунд</p>

        @if (VisibleSales.Count == 0)
        {
            <p>Пока продаж нет.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Время</th>
                            <th>Марка</th>
                            <th>Модель</th>
                            <th>Год</th>
                            <th>Л.с.</th>
                            <th>Пробег</th>
                            <th>Состояние</th>
                            <th>Цвет</th>
                            <th>Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in VisibleSales)
                        {
                            <tr>
                                <td>@sale.SoldAt.ToString("HH:mm:ss")</td>
                                <td>@sale.Car.Brand</td>
                                <td>@sale.Car.Model</td>
                                <td>@sale.Car.Year</td>
                                <td>@sale.Car.HorsePower</td>
                                <td>@Mileage(sale.Car)</td>
                                <td>@Condition(sale.Car)</td>
                                <td>@sale.Car.Color</td>
                                <td>@sale.Car.Price.ToString("N0") ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "finance")
    {
        <p class="text-muted">Бюджет компании</p>

        <table class="table">
            <tbody>
                <tr>
                    <td>Машин в наличии</td>
                    <td>@CarCatalog.Cars.Count</td>
                </tr>
                <tr>
                    <td>Стоимость машин в наличии</td>
                    <td>@CarCatalog.StockValue.ToString("N0") ₽</td>
                </tr>
                <tr>
                    <td>Баланс компании</td>
                    <td>@companyBalance.ToString("N0") ₽</td>
                </tr>
                <tr class="fw-bold">
                    <td>Общая сумма</td>
                    <td>@TotalAssets.ToString("N0") ₽</td>
                </tr>
            </tbody>
        </table>
    }
</div>

@code {
    private string activeTab = "cars";
    private string salesTab = "new";
    private Timer? timer;
    private int nextId = 1000;
    private decimal companyBalance = 20_000_000m;

    private readonly Random random = new();

    private readonly List<SaleRecord> newSales = [];

    private readonly List<SaleRecord> usedSales = [];

    private List<SaleRecord> VisibleSales => salesTab == "new" ? newSales : usedSales;

    private decimal TotalAssets => companyBalance + CarCatalog.StockValue;

    private sealed record CarModel(string Brand, string Model, decimal BasePrice, int MinHorsePower, int MaxHorsePower);

    private static readonly CarModel[] carModels =
    [
        new("Audi", "A3", 3_500_000, 110, 190),
        new("Audi", "A4", 4_200_000, 150, 265),
        new("Audi", "A6", 6_500_000, 190, 340),
        new("Audi", "Q5", 5_500_000, 150, 265),
        new("Audi", "Q7", 8_000_000, 250, 340),
        new("Audi", "Q8", 11_000_000, 300, 507),
        new("Audi", "e-tron", 7_000_000, 230, 408),
        new("Volkswagen", "Polo", 1_500_000, 90, 125),
        new("Volkswagen", "Golf", 2_400_000, 110, 300),
        new("Volkswagen", "Passat", 3_000_000, 150, 280),
        new("Volkswagen", "Tiguan", 3_700_000, 150, 245),
        new("Volkswagen", "Touareg", 6_800_000, 250, 340),
        new("Volkswagen", "Arteon", 4_000_000, 190, 320),
        new("Volkswagen", "Teramont", 4_800_000, 220, 280),
        new("Skoda", "Fabia", 1_200_000, 90, 125),
        new("Skoda", "Rapid", 1_300_000, 90, 125),
        new("Skoda", "Octavia", 2_600_000, 110, 245),
        new("Skoda", "Superb", 3_400_000, 150, 280),
        new("Skoda", "Karoq", 2_700_000, 110, 190),
        new("Skoda", "Kodiaq", 3_600_000, 150, 220)
    ];

    private static readonly string[] carColors =
    [
        "Белый", "Чёрный", "Серый", "Синий", "Красный", "Серебристый"
    ];

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        timer = new Timer(_ => InvokeAsync(AddRandomSale), null, TimeSpan.Zero, TimeSpan.FromSeconds(30));
    }

    private void AddRandomSale()
    {
        AddSale(newSales, CreateRandomCar(isUsed: false));
        AddSale(usedSales, CreateRandomCar(isUsed: true));

        StateHasChanged();
    }

    private static void AddSale(List<SaleRecord> sales, Car car)
    {
        sales.Insert(0, new SaleRecord { Car = car, SoldAt = DateTime.Now });

        if (sales.Count > 20)
        {
            sales.RemoveAt(sales.Count - 1);
        }
    }

    private Car CreateRandomCar(bool isUsed)
    {
        var model = carModels[random.Next(carModels.Length)];
        var currentYear = DateTime.Now.Year;
        var year = isUsed
            ? random.Next(2018, currentYear - 1)
            : random.Next(currentYear - 1, currentYear + 1);
        var age = currentYear - year;

        var price = model.BasePrice
            * (decimal)Math.Pow(0.88, age)
            * (0.93m + (decimal)random.NextDouble() * 0.14m);
        price = Math.Round(price / 10_000m) * 10_000m;

        return new Car
        {
            Id = nextId++,
            Brand = model.Brand,
            Model = model.Model,
            Year = year,
            HorsePower = random.Next(model.MinHorsePower, model.MaxHorsePower + 1),
            IsUsed = isUsed,
            MileageKm = isUsed ? random.Next(age * 8_000, age * 22_000 + 1) : 0,
            Color = carColors[random.Next(carColors.Length)],
            Price = price
        };
    }

    private static string Mileage(Car car) => car.IsUsed ? $"{car.MileageKm:N0} км" : "0 км";

    private static string Condition(Car car) => car.IsUsed ? "С пробегом" : "Новая";

    private void ShowCars() => activeTab = "cars";

    private void ShowSales() => activeTab = "sales";

    private void ShowNewSales() => salesTab = "new";

    private void ShowUsedSales() => salesTab = "used";

    private void ShowFinance() => activeTab = "finance";

    public void Dispose() => timer?.Dispose();
}
